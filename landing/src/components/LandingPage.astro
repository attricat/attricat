---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from './Logo.astro';
import type { Locale } from '../content';
import { content } from '../content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];
const isPolish = locale === 'pl';
const docsUrl = isPolish ? 'https://docs.attricat.com/pl/' : 'https://docs.attricat.com/';
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description} nav={t.nav}>
  <section class="hero shell">
    <div class="hero-copy">
      <div class="eyebrow">{t.hero.eyebrow}</div>
      <h1>{t.hero.titleStart}<br /><em>{t.hero.titleAccent}</em></h1>
      <p>{t.hero.body}</p>
      <div class="hero-actions">
        <a class="button" href="mailto:hello@attricat.com">{t.hero.primary}<span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href="#product">{t.hero.secondary}<span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-note"><span class="avatars"><b>P</b><b>C</b><b>O</b></span>{t.hero.note}</div>
    </div>

    <div class="product-frame" aria-label={t.preview.label}>
      <div class="frame-top">
        <span class="mini-brand"><Logo compact /></span>
        <div class="fake-search"><span>⌕</span>{t.preview.search}</div>
        <span class="round-icon">?</span><span class="avatar">AM</span>
      </div>
      <div class="frame-body">
        <aside>
          <strong>A</strong>
          <span class="side-icon active">⌂</span><span class="side-icon">◇</span><span class="side-icon">◎</span><span class="side-icon">≡</span>
          <span class="side-icon bottom">⚙</span>
        </aside>
        <div class="catalog">
          <div class="crumb">{t.preview.label} <span>/</span> 2025</div>
          <div class="catalog-head">
            <div><h3>{t.preview.title}</h3><span class="status">● {t.preview.status}</span></div>
            <div class="market"><small>{t.preview.context}</small><strong>◎ {t.preview.market}⌄</strong></div>
          </div>
          <div class="filters"><span>All products</span><span>Category⌄</span><span>Completeness⌄</span><i></i><button>＋</button></div>
          <div class="table-head"><span>Product</span><span>Type</span><span>Details</span><span>Status</span></div>
          {t.preview.items.map((item, index) => (
            <div class="table-row">
              <div><i class={`thumb thumb-${index}`}></i><strong>{item.name}</strong></div>
              <span>{item.type}</span><span>{item.detail}</span><span class={index === 2 ? 'review' : 'complete'}>● {item.status}</span>
            </div>
          ))}
          <div class="selection"><span>✓ {t.preview.selected}</span><button><i>✦</i> {t.preview.action}</button></div>
        </div>
      </div>
    </div>
  </section>

  <section class="proof shell" aria-label={t.proof.intro}>
    <p>{t.proof.intro}</p>
    <div>{t.proof.items.map((item) => <span><i>✓</i>{item}</span>)}</div>
  </section>

  <section class="value-section" id="product">
    <div class="shell section-heading">
      <div class="eyebrow">{t.value.eyebrow}</div>
      <div class="heading-grid"><h2>{t.value.title}</h2><p>{t.value.body}</p></div>
    </div>
    <div class="value-cards shell">
      {t.value.cards.map((card, index) => (
        <article class={`value-card card-${index}`}>
          <div class="card-visual" aria-hidden="true">
            {index === 0 && <div class="schema"><span class="schema-main">Product</span><i></i><div><span>Variant</span><span>Media</span><span>Supplier</span></div></div>}
            {index === 1 && <div class="contexts"><div class="globe">◎</div><span class="ctx-one">Global</span><span class="ctx-two">Polska</span><span class="ctx-three">United Kingdom</span></div>}
            {index === 2 && <div class="history"><div><b>Today</b><span>Product copy approved</span></div><div><b>May 18</b><span>Market details updated</span></div><div><b>May 12</b><span>New revision published</span></div></div>}
          </div>
          <span class="card-number">{card.number}</span>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
          <span class="tag">↗ {card.tag}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="teams-section shell" id="teams">
    <div class="eyebrow">{t.teams.eyebrow}</div>
    <h2>{t.teams.title}</h2>
    <div class="team-tabs" role="tablist">
      {t.teams.tabs.map((tab, index) => <button role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-tab={index}>{tab}</button>)}
    </div>
    <div class="team-stage">
      <div class="team-copy">
        {t.teams.quotes.map((quote, index) => (
          <article class:list={{ active: index === 0 }} data-panel={index}>
            <h3>{quote.title}</h3><p>{quote.body}</p>
            <ul>{quote.points.map((point) => <li><span>✓</span>{point}</li>)}</ul>
          </article>
        ))}
      </div>
      <div class="team-visual" aria-hidden="true">
        <div class="floating-card main-product"><span class="product-img"></span><div><small>PRODUCT / 0248</small><b>Ridgeline Pro</b><em>Updated 2 min ago</em></div><i>98%</i></div>
        <div class="floating-card relation"><small>RELATED RECORDS</small><span><b>8</b> Variants</span><span><b>4</b> Markets</span><span><b>12</b> Assets</span></div>
        <div class="floating-card activity"><small>RECENT ACTIVITY</small><span class="activity-line"></span><p><b>Anna</b> approved product content</p><em>Just now</em></div>
        <span class="decor-dot dot-a"></span><span class="decor-dot dot-b"></span>
      </div>
    </div>
  </section>

  <section class="ai-section">
    <div class="shell ai-grid">
      <div class="ai-copy">
        <div class="eyebrow">{t.ai.eyebrow}</div>
        <h2>{t.ai.title}</h2>
        <p>{t.ai.body}</p>
        <ul>{t.ai.points.map((point) => <li><span>✓</span>{point}</li>)}</ul>
      </div>
      <div class="chat-window">
        <div class="chat-head"><span><i>✦</i> Attricat Agent</span><b>•••</b></div>
        <div class="chat-body">
          <div class="message user-message"><span>AM</span><p>{t.ai.user}</p></div>
          <div class="message agent-message"><span>✦</span><p>{t.ai.agent}</p></div>
          <div class="approval-card"><div><i>!</i><p>{t.ai.approval}</p></div><button>{t.ai.approve} →</button></div>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-section shell" id="trust">
    <div class="eyebrow">{t.trust.eyebrow}</div>
    <h2>{t.trust.title}</h2>
    <div class="trust-grid">
      {t.trust.items.map((item, index) => <article><span>0{index + 1}</span><h3>{item.stat}</h3><p>{item.label}</p></article>)}
    </div>
  </section>

  <section class="cta-section shell">
    <div class="cta-panel">
      <div class="cta-orbit" aria-hidden="true"><i></i><b>✦</b><span></span></div>
      <div class="eyebrow">{t.cta.eyebrow}</div>
      <h2>{t.cta.title}</h2>
      <p>{t.cta.body}</p>
      <div><a class="button light-button" href="mailto:hello@attricat.com">{t.cta.primary}<span>↗</span></a><a class="text-link" href={docsUrl}>{t.cta.secondary} →</a></div>
    </div>
  </section>

  <footer slot="footer" class="footer">
    <div class="shell footer-grid">
      <div><Logo /><p>{t.footer.line}</p></div>
      <div><b>{t.footer.product}</b><a href="#product">{t.footer.links[0]}</a><a href="#teams">{t.footer.links[1]}</a><a href="#trust">{t.footer.links[2]}</a></div>
      <div><b>{t.footer.resources}</b><a href={docsUrl}>{t.footer.docs}</a><a href="https://github.com/attricat/attricat">{t.footer.github}</a></div>
    </div>
    <div class="shell footer-bottom"><span>© {new Date().getFullYear()} {t.footer.copyright}</span><a href={isPolish ? '/' : '/pl/'}>{isPolish ? 'English' : 'Polski'} ↗</a></div>
  </footer>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const active = tab.dataset.tab;
    tabs.forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
    panels.forEach((panel) => panel.classList.toggle('active', panel.dataset.panel === active));
  }));
</script>

<style>
  .hero { align-items: center; display: grid; gap: 52px; grid-template-columns: .86fr 1.14fr; min-height: 720px; padding-bottom: 70px; padding-top: 72px; }
  .hero-copy { position: relative; z-index: 2; }
  .hero h1 { font-size: clamp(3.25rem, 5.7vw, 5.45rem); line-height: .99; margin: 23px 0 28px; }
  .hero h1 em { color: var(--accent); font-style: normal; }
  .hero-copy > p { color: var(--muted); font-size: 1.08rem; margin: 0; max-width: 560px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .hero-note { align-items: center; color: var(--muted); display: flex; font-size: .8rem; gap: 12px; margin-top: 30px; }
  .avatars { display: flex; }
  .avatars b { align-items: center; background: var(--accent-soft); border: 2px solid var(--paper); border-radius: 50%; color: var(--accent); display: flex; font-size: .59rem; height: 26px; justify-content: center; margin-left: -7px; width: 26px; }
  .avatars b:first-child { margin-left: 0; }

  .product-frame { background: var(--white); border: 1px solid #d6d8d2; border-radius: 16px; box-shadow: 0 35px 80px rgba(23, 38, 33, .13); min-width: 690px; overflow: hidden; position: relative; transform: perspective(1300px) rotateY(-3deg) rotateX(1deg); }
  .product-frame::after { background: var(--lime); border-radius: 50%; content: ''; filter: blur(2px); height: 130px; position: absolute; right: -74px; top: -58px; width: 130px; z-index: -1; }
  .frame-top { align-items: center; border-bottom: 1px solid #ecece8; display: flex; gap: 12px; height: 56px; padding: 0 16px; }
  .mini-brand { margin-right: 8px; transform: scale(.72); }
  .fake-search { align-items: center; background: #f4f5f2; border-radius: 7px; color: #8a928e; display: flex; flex: 1; font-size: .68rem; gap: 8px; padding: 8px 12px; }
  .fake-search span { font-size: 1rem; }
  .round-icon, .avatar { align-items: center; border: 1px solid #e0e2de; border-radius: 50%; display: flex; font-size: .62rem; height: 28px; justify-content: center; width: 28px; }
  .avatar { background: #d7e8e0; border: 0; color: var(--accent); font-weight: 700; }
  .frame-body { display: flex; min-height: 424px; }
  .frame-body aside { align-items: center; border-right: 1px solid #ecece8; display: flex; flex-direction: column; gap: 8px; padding: 16px 10px 12px; width: 55px; }
  .frame-body aside > strong { align-items: center; background: var(--accent); border-radius: 7px; color: white; display: flex; font-family: var(--display); font-size: .7rem; height: 28px; justify-content: center; margin-bottom: 8px; width: 28px; }
  .side-icon { align-items: center; border-radius: 6px; color: #7b8681; display: flex; font-size: .78rem; height: 28px; justify-content: center; width: 30px; }
  .side-icon.active { background: var(--accent-soft); color: var(--accent); }
  .side-icon.bottom { margin-top: auto; }
  .catalog { flex: 1; padding: 22px 23px 58px; position: relative; }
  .crumb { color: #89918d; font-size: .57rem; margin-bottom: 17px; }
  .crumb span { margin-inline: 5px; }
  .catalog-head { align-items: flex-start; display: flex; justify-content: space-between; }
  .catalog-head h3 { font-size: 1.22rem; margin-bottom: 8px; }
  .status { background: #e1f1e8; border-radius: 999px; color: var(--accent); font-size: .55rem; font-weight: 600; padding: 4px 7px; }
  .market { align-items: flex-start; background: #f7f7f4; border: 1px solid #e6e6e1; border-radius: 6px; display: flex; flex-direction: column; gap: 3px; padding: 7px 10px; }
  .market small { color: #929a96; font-size: .5rem; }
  .market strong { font-size: .61rem; }
  .filters { align-items: center; border-bottom: 1px solid #e2e3de; display: flex; gap: 7px; margin-top: 23px; padding-bottom: 12px; }
  .filters span { background: #f3f4f1; border-radius: 5px; color: #626d68; font-size: .55rem; padding: 6px 8px; }
  .filters span:first-child { background: var(--accent-soft); color: var(--accent); }
  .filters i { flex: 1; }
  .filters button { background: var(--accent); border: 0; border-radius: 5px; color: white; height: 24px; width: 26px; }
  .table-head, .table-row { align-items: center; display: grid; gap: 12px; grid-template-columns: 2fr 1.1fr .8fr .8fr; }
  .table-head { color: #929995; font-size: .49rem; padding: 11px 8px 7px; text-transform: uppercase; }
  .table-row { border-top: 1px solid #eeeeea; color: #59635f; font-size: .58rem; min-height: 57px; padding: 7px 8px; }
  .table-row > div { align-items: center; color: var(--ink); display: flex; gap: 9px; }
  .thumb { background: linear-gradient(145deg, #c4d2c8, #748c7e); border-radius: 5px; display: block; height: 34px; width: 34px; }
  .thumb-1 { background: linear-gradient(145deg, #dbd0bd, #846f5e); }
  .thumb-2 { background: linear-gradient(145deg, #c9d1d4, #566a76); }
  .complete { color: var(--accent); }.review { color: #af7424; }
  .selection { align-items: center; background: #162a24; bottom: 13px; color: white; display: flex; font-size: .56rem; justify-content: space-between; left: 85px; padding: 8px 9px 8px 13px; position: absolute; right: 30px; }
  .selection button { background: var(--lime); border: 0; border-radius: 3px; color: #20372f; font-size: .56rem; font-weight: 700; padding: 7px 10px; }.selection button i { color: var(--accent); }

  .proof { align-items: center; border-bottom: 1px solid var(--line); border-top: 1px solid var(--line); display: flex; gap: 50px; justify-content: space-between; padding-bottom: 28px; padding-top: 28px; }
  .proof p { font-size: .82rem; font-weight: 600; max-width: 215px; }
  .proof > div { display: flex; flex-wrap: wrap; gap: 34px; justify-content: flex-end; }
  .proof span { align-items: center; color: #4d5a55; display: flex; font-size: .78rem; font-weight: 600; gap: 8px; }.proof i { color: var(--accent); font-style: normal; }

  .value-section { padding: 128px 0; }
  .heading-grid { align-items: end; display: grid; gap: 80px; grid-template-columns: 1.25fr .75fr; margin-top: 20px; }
  .heading-grid p { color: var(--muted); margin: 0 0 5px; }
  .value-cards { display: grid; gap: 16px; grid-template-columns: repeat(3, 1fr); margin-top: 65px; }
  .value-card { background: var(--white); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; padding: 0 28px 30px; }
  .card-1 { background: #17372e; border-color: #17372e; color: white; }.card-1 p { color: #b7c7c1 !important; }.card-1 .tag { color: var(--lime); }
  .card-visual { align-items: center; display: flex; height: 215px; justify-content: center; margin: 0 -28px 27px; overflow: hidden; position: relative; }
  .card-number { color: #93a09b; font-size: .7rem; font-weight: 700; }
  .value-card h3 { font-size: 1.45rem; line-height: 1.25; margin: 13px 0; }
  .value-card p { color: var(--muted); font-size: .88rem; margin-bottom: 25px; }
  .tag { color: var(--accent); font-size: .69rem; font-weight: 700; text-transform: uppercase; }
  .schema { align-items: center; display: flex; flex-direction: column; width: 80%; }.schema-main, .schema div span { background: white; border: 1px solid #b9ccc3; border-radius: 6px; box-shadow: 0 5px 12px rgba(20,50,40,.08); font-size: .65rem; font-weight: 700; padding: 12px 25px; }.schema i { background: #a6bdb3; height: 30px; width: 1px; }.schema div { border-top: 1px solid #a6bdb3; display: flex; gap: 12px; padding-top: 18px; position: relative; }.schema div::before { background: #a6bdb3; content: ''; height: 18px; left: 50%; position: absolute; top: 0; width: 1px; }.schema div span { font-size: .52rem; padding: 9px 11px; }
  .contexts { height: 100%; position: relative; width: 100%; }.globe { color: #7fac9b; font-size: 7rem; left: 50%; opacity: .5; position: absolute; top: 44%; transform: translate(-50%,-50%); }.contexts span { background: white; border-radius: 5px; box-shadow: 0 8px 20px #0b251e66; color: var(--ink); font-size: .55rem; font-weight: 700; padding: 9px 13px; position: absolute; }.ctx-one { left: 16%; top: 35%; }.ctx-two { right: 14%; top: 25%; }.ctx-three { bottom: 20%; right: 23%; }
  .history { padding: 20px 45px; width: 100%; }.history div { border-left: 1px solid #a5b9b0; display: flex; flex-direction: column; padding: 0 0 22px 28px; position: relative; }.history div::before { background: var(--accent); border: 4px solid #dce9e3; border-radius: 50%; content: ''; height: 8px; left: -8px; position: absolute; top: 0; width: 8px; }.history b { font-size: .58rem; }.history span { color: var(--muted); font-size: .6rem; margin-top: 5px; }

  .teams-section { padding-bottom: 140px; }.teams-section > h2 { max-width: 700px; margin-top: 20px; }.team-tabs { border-bottom: 1px solid var(--line); display: flex; gap: 38px; margin-top: 45px; }.team-tabs button { background: none; border: 0; color: #7e8984; cursor: pointer; font-size: .82rem; font-weight: 700; padding: 0 0 14px; position: relative; }.team-tabs button[aria-selected="true"] { color: var(--accent); }.team-tabs button[aria-selected="true"]::after { background: var(--accent); bottom: -1px; content: ''; height: 2px; left: 0; position: absolute; right: 0; }
  .team-stage { background: var(--paper-deep); border-radius: 12px; display: grid; grid-template-columns: .9fr 1.1fr; min-height: 460px; overflow: hidden; }.team-copy { padding: 62px 20px 55px 55px; }.team-copy article { display: none; }.team-copy article.active { display: block; }.team-copy h3 { font-size: 2rem; line-height: 1.2; max-width: 450px; }.team-copy p { color: var(--muted); font-size: .93rem; max-width: 450px; }.team-copy ul, .ai-copy ul { list-style: none; margin: 28px 0 0; padding: 0; }.team-copy li, .ai-copy li { align-items: center; display: flex; font-size: .82rem; font-weight: 600; gap: 10px; margin: 11px 0; }.team-copy li span, .ai-copy li span { align-items: center; background: var(--accent-soft); border-radius: 50%; color: var(--accent); display: flex; font-size: .58rem; height: 18px; justify-content: center; width: 18px; }
  .team-visual { background: var(--accent-soft); position: relative; }.team-visual::before { border: 1px solid #b6d2c7; border-radius: 50%; content: ''; height: 410px; left: 50%; position: absolute; top: 50%; transform: translate(-50%,-50%); width: 410px; }.floating-card { background: #fff; border: 1px solid #cedbd5; border-radius: 8px; box-shadow: 0 16px 35px rgba(20,70,55,.12); position: absolute; }.main-product { align-items: center; display: flex; left: 9%; padding: 16px; right: 13%; top: 15%; }.product-img { background: linear-gradient(145deg,#c5d6cf,#527566); border-radius: 7px; height: 62px; margin-right: 14px; width: 62px; }.main-product div { display: flex; flex-direction: column; gap: 3px; }.floating-card small { color: #89958f; font-size: .49rem; letter-spacing: .08em; }.main-product b { font-family: var(--display); font-size: .93rem; }.main-product em { color: #88928e; font-size: .55rem; font-style: normal; }.main-product > i { background: var(--accent-soft); border-radius: 50%; color: var(--accent); font-size: .72rem; font-style: normal; font-weight: 700; margin-left: auto; padding: 13px 9px; }.relation { bottom: 14%; display: grid; gap: 8px; grid-template-columns: repeat(3,1fr); left: 5%; padding: 15px; width: 54%; }.relation small { grid-column: 1/-1; }.relation span { color: #6b7671; display: flex; flex-direction: column; font-size: .52rem; }.relation b { color: var(--ink); font-size: .84rem; }.activity { bottom: 12%; padding: 15px; right: 5%; width: 35%; }.activity p { font-size: .59rem; line-height: 1.4; margin: 10px 0 3px; }.activity em { color: #929b97; font-size: .5rem; font-style: normal; }.decor-dot { background: var(--lime); border-radius: 50%; height: 17px; position: absolute; width: 17px; }.dot-a { right: 8%; top: 13%; }.dot-b { bottom: 11%; left: 6%; height: 9px; width: 9px; }

  .ai-section { background: #132f27; color: white; padding: 120px 0; }.ai-grid { align-items: center; display: grid; gap: 100px; grid-template-columns: 1fr 1fr; }.ai-copy .eyebrow { color: var(--lime); }.ai-copy .eyebrow::before { background: var(--lime); }.ai-copy h2 { margin: 20px 0 24px; }.ai-copy > p { color: #bac8c3; max-width: 520px; }.ai-copy li span { background: #285144; color: var(--lime); }
