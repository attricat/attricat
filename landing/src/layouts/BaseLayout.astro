---
import Logo from '../components/Logo.astro';
import type { Locale } from '../content';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  nav: {
    product: string;
    teams: string;
    trust: string;
    docs: string;
    cta: string;
    language: string;
  };
}

const { locale, title, description, nav } = Astro.props;
const isPolish = locale === 'pl';
const localePath = isPolish ? '/' : '/pl/';
const docsPath = isPolish ? 'https://docs.attricat.com/pl/' : 'https://docs.attricat.com/';
const canonicalPath = isPolish ? '/pl/' : '/';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ed" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(canonicalPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="pl" href={new URL('/pl/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 40 40%22><path fill=%22%231c6b58%22 d=%22M10 15.5 13.5 7l6.5 5 6.5-5 3.5 8.5a13 13 0 1 1-20 0Z%22/></svg>" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-wrap shell">
        <a class="logo-link" href={isPolish ? '/pl/' : '/'}><Logo /></a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="#product">{nav.product}</a>
          <a href="#teams">{nav.teams}</a>
          <a href="#trust">{nav.trust}</a>
          <a href={docsPath}>{nav.docs}</a>
        </nav>
        <div class="nav-actions">
          <a class="language" href={localePath} aria-label={nav.language}>
            <span class={!isPolish ? 'active' : ''}>EN</span>
            <i></i>
            <span class={isPolish ? 'active' : ''}>PL</span>
          </a>
          <a class="button button-small" href="mailto:hello@attricat.com">{nav.cta}<span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');

  :root {
    --paper: #f5f3ed;
    --paper-deep: #ebe8df;
    --ink: #172621;
    --muted: #5d6964;
    --line: #d9d7ce;
    --accent: #1c6b58;
    --accent-dark: #124c40;
    --accent-soft: #dcebe4;
    --lime: #d8ee9c;
    --white: #fffefb;
    --display: 'Manrope', sans-serif;
    --body: 'DM Sans', sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    margin: 0;
    overflow-x: hidden;
  }

  a { color: inherit; text-decoration: none; }
  button { font: inherit; }
  .shell { margin-inline: auto; max-width: 1240px; padding-inline: 32px; }
  .site-header {
    backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 75%, transparent);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .nav-wrap { align-items: center; display: flex; height: 76px; justify-content: space-between; }
  .logo-link { display: inline-flex; }
  .desktop-nav { display: flex; gap: 34px; margin-left: auto; margin-right: 42px; }
  .desktop-nav a { color: #43504b; font-size: .92rem; font-weight: 600; }
  .desktop-nav a:hover { color: var(--accent); }
  .nav-actions { align-items: center; display: flex; gap: 22px; }
  .language { align-items: center; display: flex; font-size: .72rem; font-weight: 700; gap: 7px; letter-spacing: .05em; }
  .language span { color: #919a96; }
  .language span.active { color: var(--ink); }
  .language i { background: #afb5b2; display: block; height: 13px; width: 1px; }

  .button {
    align-items: center;
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: white;
    display: inline-flex;
    font-size: .94rem;
    font-weight: 700;
    gap: 13px;
    justify-content: center;
    padding: 15px 22px;
    transition: transform .2s ease, background .2s ease;
  }
  .button:hover { background: var(--accent-dark); transform: translateY(-2px); }
  .button-small { font-size: .84rem; padding: 11px 18px; }
  .button-outline { background: transparent; border-color: #aab1ad; color: var(--ink); }
  .button-outline:hover { background: var(--white); }

  .eyebrow {
    align-items: center;
    color: var(--accent);
    display: flex;
    font-size: .76rem;
    font-weight: 700;
    gap: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .eyebrow::before { background: var(--accent); content: ''; height: 1px; width: 25px; }

  h1, h2, h3 { font-family: var(--display); letter-spacing: -.045em; margin: 0; }
  h2 { font-size: clamp(2.15rem, 4vw, 4rem); line-height: 1.08; }
  p { line-height: 1.65; }

  @media (max-width: 840px) {
    .shell { padding-inline: 20px; }
    .desktop-nav { display: none; }
    .nav-actions { gap: 14px; }
  }
  @media (max-width: 520px) {
    .nav-wrap { height: 68px; }
    .button-small { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>
