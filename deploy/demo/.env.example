# Copy to .env (chmod 600); replace the infrastructure secret placeholders.
# Reset never pulls images. Pull explicitly before initial setup or upgrades.
ATTRICAT_IMAGE=ghcr.io/attricat/attricat:latest
ATTRICAT_OWNER_EMAIL=owner@example.com
# Public evaluation credentials. reset.sh restores these on every run.
# These are owner/admin credentials, NOT a restricted guest account.
ATTRICAT_OWNER_PASSWORD=test
POSTGRES_PASSWORD=replace-me
S3_SECRET_ACCESS_KEY=replace-me
