# Copy to .env (chmod 600) and replace every placeholder with a generated value.
ATTRICAT_IMAGE=ghcr.io/attricat/attricat:latest
ATTRICAT_OWNER_EMAIL=owner@example.com
# Needed only for the first start; remove it once the owner can sign in.
ATTRICAT_OWNER_PASSWORD=replace-me
POSTGRES_PASSWORD=replace-me
S3_SECRET_ACCESS_KEY=replace-me
