# Pin a release by digest after promotion; never deploy a mutable latest tag.
ATTRICAT_IMAGE=ghcr.io/attricat/attricat@sha256:replace-me
ATTRICAT_BIND_IP=127.0.0.1
ATTRICAT_PORT=3000

DATABASE_URL=postgres://attricat:replace-me@postgres.example:5432/attricat
DATABASE_REQUEST_POOL_CONNECTIONS=10
DATABASE_TASK_POOL_CONNECTIONS=10
CATALOG_AUTO_MIGRATE=false
CATALOG_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
CATALOG_BOOTSTRAP_WORKSPACE_NAME="Default workspace"
CATALOG_BOOTSTRAP_OWNER_EMAIL=owner@example.com
# Inject password only for initial bootstrap, then remove it.
CATALOG_BOOTSTRAP_OWNER_PASSWORD=replace-me
SESSION_COOKIE_SECURE=true
CATALOG_DEVTOOLS=false
RUST_LOG=info

# Optional: share the query cache and extension rate limits between API
# replicas. Use rediss:// for TLS. Flush Redis after restoring a backup.
# CACHE_BACKEND=redis
# REDIS_URL=rediss://:replace-me@redis.example.com:6380/0

S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=attricat
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_TIMEOUT_SECONDS=30
S3_DOWNLOAD_TIMEOUT_SECONDS=30

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM="Attricat <no-reply@example.com>"
PASSWORD_RESET_URL=https://catalog.example.com/password-reset/confirm
WORKSPACE_INVITATION_URL=https://catalog.example.com/invitations/accept
WORKSPACE_ONBOARDING_URL=https://catalog.example.com/onboarding

# Required because the production worker listener binds outside loopback.
FILE_WORKER_METRICS_TOKEN=replace-with-a-monitoring-only-secret
FILE_WORKER_POLL_MILLISECONDS=500
FILE_WORKER_MAX_PIXELS=40000000
FILE_WORKER_MAX_ATTEMPTS=5
FILE_DELETE_GRACE_SECONDS=86400
