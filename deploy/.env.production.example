# Pin a release by digest after promotion; never deploy a mutable latest tag.
ATTRICAT_IMAGE=ghcr.io/attricat/attricat@sha256:replace-me
ATTRICAT_BIND_IP=127.0.0.1
ATTRICAT_PORT=3000
# Directory holding one file per secret, mounted as Docker secrets at
# /run/secrets. Secrets are never set here: the binaries refuse them as
# environment variables. Create every file, readable by uid 10001:
#   database_url               postgres://attricat:…@postgres.example:5432/attricat
#   s3_secret_access_key       S3 secret access key
#   smtp_password              SMTP password (empty without SMTP_USERNAME)
#   llm_api_key                agent provider key (empty disables agents)
#   redis_url                  rediss://… URL (empty unless CACHE_BACKEND=redis)
#   bootstrap_owner_password   first-start owner password; empty it afterwards
#   file_worker_metrics_token  bearer token for the file worker's /metrics
#   api_metrics_token          bearer token for the API's /metrics; empty closes it
#   operator_api_token         enables the operator API; at least 32 bytes
#   identity_provider_credential_key  32 base64-encoded bytes; needed with OIDC_CALLBACK_URL
ATTRICAT_SECRETS_HOST_DIR=./secrets

DATABASE_REQUEST_POOL_CONNECTIONS=10
DATABASE_TASK_POOL_CONNECTIONS=10
ATTRICAT_AUTO_MIGRATE=false
ATTRICAT_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
ATTRICAT_BOOTSTRAP_WORKSPACE_NAME="Default workspace"
ATTRICAT_BOOTSTRAP_OWNER_EMAIL=owner@example.com
SESSION_COOKIE_SECURE=true
ATTRICAT_DEVTOOLS=false
RUST_LOG=info

# Optional: share the query cache and extension rate limits between API
# replicas, through the redis_url secret. Use rediss:// for TLS. Flush Redis
# after restoring a backup.
# CACHE_BACKEND=redis

S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=attricat
S3_ACCESS_KEY_ID=replace-me
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_TIMEOUT_SECONDS=30
S3_DOWNLOAD_TIMEOUT_SECONDS=30

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=replace-me
MAIL_FROM="Attricat <no-reply@example.com>"
PASSWORD_RESET_URL=https://attricat.example.com/password-reset/confirm
WORKSPACE_INVITATION_URL=https://attricat.example.com/invitations/accept
WORKSPACE_ONBOARDING_URL=https://attricat.example.com/onboarding

# The file_worker_metrics_token secret is required because the production
# worker listener binds outside loopback.
FILE_WORKER_POLL_MILLISECONDS=500
FILE_WORKER_MAX_PIXELS=40000000
FILE_WORKER_MAX_ATTEMPTS=5
FILE_DELETE_GRACE_SECONDS=86400
