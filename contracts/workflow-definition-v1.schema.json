{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "description": "Definition format version. `1` accepts only record event triggers;\n`2` also accepts `manual`, `schedule` and `extension_event` triggers.",
      "enum": [
        1,
        2
      ]
    },
    "code": {
      "type": "string",
      "description": "Stable workflow identifier, unique within its owner.",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable workflow name.",
      "pattern": "\\S"
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Trigger"
      },
      "description": "What starts the workflow. At least one.",
      "minItems": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Action"
      },
      "description": "Record actions applied in order when a trigger fires. At least one.",
      "minItems": 1
    }
  },
  "required": [
    "format_version",
    "code",
    "name",
    "triggers",
    "actions"
  ],
  "title": "Attricat workflow definition",
  "description": "An automation that applies fixed record actions when one of its triggers fires.",
  "allOf": [
    {
      "description": "Format version 1 accepts only record event triggers.",
      "if": {
        "properties": {
          "format_version": {
            "const": 1
          }
        },
        "required": [
          "format_version"
        ]
      },
      "then": {
        "properties": {
          "triggers": {
            "items": {
              "not": {
                "required": [
                  "type"
                ]
              }
            }
          }
        }
      }
    },
    {
      "description": "Manual and schedule triggers carry no event facts, so attribute writes need fixed values.",
      "if": {
        "properties": {
          "triggers": {
            "contains": {
              "properties": {
                "type": {
                  "enum": [
                    "manual",
                    "schedule"
                  ]
                }
              },
              "required": [
                "type"
              ]
            }
          }
        },
        "required": [
          "triggers"
        ]
      },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "not": {
                "required": [
                  "event_field"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Trigger": {
      "description": "What starts the workflow.",
      "oneOf": [
        {
          "$ref": "#/$defs/EventTrigger"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "manual"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Runs when started on demand for one record. Requires `format_version: 2`."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cron": {
              "type": "string",
              "description": "Six-field cron expression, including seconds: `sec min hour day month weekday`.",
              "pattern": "^\\s*\\S+(?:\\s+\\S+){5}\\s*$"
            },
            "timezone": {
              "type": "string",
              "description": "Schedule time zone. Only `UTC` is supported.",
              "enum": [
                "UTC"
              ]
            },
            "target_record_id": {
              "type": "string",
              "description": "UUID of the record the scheduled run acts on.",
              "pattern": "^(?:[0-9A-Fa-f]{32}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}|\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\}|urn:uuid:[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$"
            },
            "type": {
              "type": "string",
              "const": "schedule"
            }
          },
          "required": [
            "type",
            "cron",
            "timezone",
            "target_record_id"
          ],
          "description": "Runs on a UTC cron schedule for one fixed record. Requires `format_version: 2`."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "description": "Extension that emits the event.",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "event_type": {
              "type": "string",
              "description": "Versioned extension event, such as `plugin.example.changed.v1`.",
              "pattern": "^plugin\\.(?:[\\s\\S]*\\.)?v1$"
            },
            "contract_version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1,
              "description": "Version of the event payload contract."
            },
            "type": {
              "type": "string",
              "const": "extension_event"
            }
          },
          "required": [
            "type",
            "provider",
            "event_type",
            "contract_version"
          ],
          "description": "Reserved: runs when an extension emits a versioned event. Delivery is\nnot enabled yet. Requires `format_version: 2`."
        }
      ]
    },
    "EventTrigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "type": "string",
          "description": "Record event that starts the workflow.",
          "enum": [
            "record.created.v1",
            "record.updated.v1",
            "record.migrated.v1",
            "attribute_value.changed.v1",
            "attribute_value.restored.v1",
            "relationship.changed.v1"
          ]
        },
        "envelope": {
          "type": "object",
          "default": {},
          "propertyNames": {
            "anyOf": [
              {
                "enum": [
                  "event_type",
                  "aggregate_kind",
                  "source_kind",
                  "source_name"
                ]
              },
              {
                "pattern": "^metadata\\.[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
              }
            ]
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "x-attricat-key-suggestions": [
            "event_type",
            "aggregate_kind",
            "source_kind",
            "source_name"
          ],
          "description": "Scalar values the event envelope must match: `event_type`,\n`aggregate_kind`, `source_kind`, `source_name` or `metadata.<path>`."
        },
        "facts": {
          "type": "object",
          "default": {},
          "propertyNames": {
            "pattern": "^facts\\.\\+?[0-9]+(?:\\.[A-Za-z0-9_-]+)+$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Scalar values the event facts must match, keyed `facts.<index>.<field>`."
        },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "x-attricat-reference": "attribute"
          },
          "description": "Match only events whose changed facts name one of these attribute\ncodes. Not allowed with `record.migrated.v1`.",
          "default": null
        },
        "blueprints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "x-attricat-reference": "blueprint"
          },
          "description": "Match only events of records of these blueprints, by code. Omit to\nmatch every blueprint.",
          "default": null
        },
        "change_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "set",
              "replace",
              "remove",
              "restore",
              "relationship_add",
              "relationship_remove"
            ]
          },
          "description": "Match only events with a changed fact of one of these kinds, such as\n`relationship_add` or `relationship_remove`. With `attributes`, the\nsame fact must also name one of those attributes. Not allowed with\n`record.migrated.v1`.",
          "default": null
        },
        "tags_added": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "description": "At most 128 bytes of UTF-8.",
            "maxLength": 128,
            "pattern": "\\S"
          },
          "description": "Match only events that added one of these system tags. Allowed with\n`record.created.v1` and `record.updated.v1`.",
          "default": null
        },
        "tags_removed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "description": "At most 128 bytes of UTF-8.",
            "maxLength": 128,
            "pattern": "\\S"
          },
          "description": "Match only events that removed one of these system tags. Allowed with\n`record.updated.v1`.",
          "default": null
        }
      },
      "required": [
        "event_type"
      ],
      "description": "Runs when a record event occurs. Event triggers have no `type` key.",
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "record.migrated.v1"
              }
            },
            "required": [
              "event_type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "attributes"
                  ]
                },
                {
                  "required": [
                    "change_kinds"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "not": {
                  "enum": [
                    "record.created.v1",
                    "record.updated.v1"
                  ]
                }
              }
            },
            "required": [
              "event_type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "tags_added"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "not": {
                  "enum": [
                    "record.updated.v1"
                  ]
                }
              }
            },
            "required": [
              "event_type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "tags_removed"
              ]
            }
          }
        }
      ]
    },
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "description": "At most 128 bytes of UTF-8.",
                "maxLength": 128,
                "pattern": "\\S"
              },
              "description": "Tags to add, each at most 128 bytes, without duplicates."
            },
            "type": {
              "type": "string",
              "const": "system_tags_add"
            }
          },
          "required": [
            "type",
            "tags"
          ],
          "description": "Adds system tags to the record."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "description": "At most 128 bytes of UTF-8.",
                "maxLength": 128,
                "pattern": "\\S"
              },
              "description": "Tags to remove, without duplicates."
            },
            "type": {
              "type": "string",
              "const": "system_tags_remove"
            }
          },
          "required": [
            "type",
            "tags"
          ],
          "description": "Removes system tags from the record."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "values": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "description": "Scalar values keyed by dotted metadata path, such as `review.state`."
            },
            "type": {
              "type": "string",
              "const": "system_metadata_merge"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "description": "Merges scalar values into the record's system metadata."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keys": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "description": "Metadata keys to delete, without duplicates."
            },
            "type": {
              "type": "string",
              "const": "system_metadata_delete"
            }
          },
          "required": [
            "type",
            "keys"
          ],
          "description": "Deletes keys from the record's system metadata."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attribute_code": {
              "type": "string",
              "description": "Attribute to write.",
              "pattern": "^[A-Za-z0-9_-]+$",
              "x-attricat-reference": "attribute"
            },
            "fixed": {
              "type": [
                "string",
                "number",
                "boolean"
              ],
              "description": "Scalar value to write.",
              "default": null
            },
            "event_field": {
              "type": [
                "string",
                "null"
              ],
              "description": "Event fact to copy, as `facts.<index>.<field>`. Record event\ntriggers only.",
              "pattern": "^facts\\.\\+?[0-9]+(?:\\.[A-Za-z0-9_-]+)+$"
            },
            "type": {
              "type": "string",
              "const": "attribute_write"
            }
          },
          "required": [
            "type",
            "attribute_code"
          ],
          "description": "Writes one attribute value. Set exactly one of `fixed` and `event_field`.",
          "if": {
            "required": [
              "fixed"
            ]
          },
          "then": {
            "not": {
              "required": [
                "event_field"
              ]
            }
          },
          "else": {
            "required": [
              "event_field"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "relationship_attribute": {
              "type": "string",
              "description": "Relationship attribute of the referencing records.",
              "pattern": "^[A-Za-z0-9_-]+$",
              "x-attricat-reference": "relationship_attribute"
            },
            "max_targets": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 1,
              "description": "Most referencing records to update; more fails the action before\nany record changes.",
              "maximum": 500,
              "default": 100
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/Action",
                "not": {
                  "anyOf": [
                    {
                      "properties": {
                        "type": {
                          "const": "referencing_records_update"
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    {
                      "required": [
                        "event_field"
                      ]
                    }
                  ]
                }
              },
              "description": "Actions applied to each referencing record. Attribute writes need\n`fixed` values and updates cannot nest."
            },
            "type": {
              "type": "string",
              "const": "referencing_records_update"
            }
          },
          "required": [
            "type",
            "relationship_attribute",
            "actions"
          ],
          "description": "Applies fixed actions to every live record whose relationship\nattribute targets the trigger record."
        }
      ],
      "description": "A record change the workflow makes."
    }
  }
}
