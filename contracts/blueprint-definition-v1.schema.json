  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An Attricat blueprint: a versioned record type or an includable mixin.",
  "properties": {
    "attributes": {
      "description": "Attributes in display order. Each declares exactly one of `value_type`,\n`extension_type`, or `from`.",
      "items": {
        "$ref": "#/$defs/RawAttributeDeclaration"
      },
      "minItems": 1,
      "type": "array"
    },
    "code": {
      "description": "Stable blueprint identifier, using ASCII letters, numbers, hyphens, and underscores.",
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "connector_jobs": {
      "default": [],
      "description": "Scheduled extension imports and exports. Record blueprints only.",
      "items": {
        "$ref": "#/$defs/ConnectorJobDefinition"
      },
      "type": "array"
    },
    "description": {
      "description": "What the blueprint's records are, for people and agents, such as\n\"Product groupings, such as Basic tools\". `{{…}}` references resolve\nfrom the workspace lexicon.",
      "maxLength": 500,
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "additionalProperties": true,
      "default": {},
      "description": "Namespaced extension metadata is preserved in the immutable source\ndefinition and intentionally ignored by the core blueprint compiler.",
      "type": "object"
    },
    "format_version": {
      "const": 1,
      "description": "Definition format version. Only `1` is supported.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "includes": {
      "default": [],
      "description": "Exact, version-pinned mixins whose attributes can be selected with `from`.",
      "items": {
        "$ref": "#/$defs/IncludeRef"
      },
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/BlueprintKind"
    },
    "name": {
      "description": "Human-readable blueprint name. `{{…}}` references resolve from the\nworkspace lexicon.",
      "minLength": 1,
      "type": "string"
    },
    "publication": {
      "$ref": "#/$defs/PublicationPolicy",
      "default": {
        "retain_on_edit_roles": []
      },
      "description": "Channel publication behavior when records are edited."
    },
    "record_schema": {
      "description": "JSON Schema (Draft 2020-12) source for cross-field record validation.\nRecord blueprints only.",
      "type": [
        "string",
        "null"
      ]
    },
    "unique_keys": {
      "default": [],
      "description": "Business keys whose normalized values must be unique across the\nblueprint family. Record blueprints only.",
      "items": {
        "$ref": "#/$defs/UniqueKeyDefinition"
      },
      "type": "array"
    },
    "views": {
      "additionalProperties": {
        "$ref": "#/$defs/ViewDefinition"
      },
      "default": {},
      "description": "Named views: `dropdown_option`, `page_title`, `table`, `detail`, and `extension_layout`.\nThe `detail` layout also drives editing.",
      "type": "object",
      "x-attricat-key-suggestions": [
        "dropdown_option",
        "page_title",
        "detail",
        "table",
        "explorer",
        "extension_layout"
      ]
    }
  },
  "required": [
    "format_version",
    "code",
    "name",
    "kind",
    "attributes"
  ],
  "title": "Attricat blueprint definition v1",
  "type": "object"
}
