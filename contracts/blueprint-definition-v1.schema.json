{
  "$defs": {
    "BlueprintKind": {
      "oneOf": [
        {
          "const": "record",
          "description": "Creates records.",
          "type": "string"
        },
        {
          "const": "mixin",
          "description": "Provides attributes for other blueprints to include.",
          "type": "string"
        }
      ]
    },
    "BrowseBy": {
      "anyOf": [
        {
          "description": "Relationship attribute code, or a dotted path of up to three\nrelationship hops.",
          "type": "string"
        },
        {
          "const": false,
          "description": "`false` keeps the rail closed until a person opens it.",
          "type": "boolean"
        }
      ],
      "description": "The Explorer browse rail's default: a relationship field or path, or `false`.",
      "x-attricat-reference": "relationship_path"
    },
    "ComponentReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Registered component ID, such as `attricat.field_edit`.",
          "type": "string",
          "x-attricat-reference": "view_component"
        },
        "props": {
          "additionalProperties": true,
          "default": null,
          "description": "Component-specific properties.",
          "type": "object"
        },
        "version": {
          "description": "Component manifest versions are non-negative 32-bit protocol values.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "ConnectorJobDefinition": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Stable job identifier, unique within the blueprint.",
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "connection": {
          "description": "The extension connection (destination account) an export pushes to.\nWithout it the extension's default destination is used.",
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "description": "Context code that receives imported values, required for imports; for\nan export, the publication channel it exports.",
          "type": [
            "string",
            "null"
          ],
          "x-attricat-reference": "context"
        },
        "direction": {
          "description": "`import` requires `context`; `export` cannot set `input_file_id`.",
          "enum": [
            "import",
            "export"
          ],
          "type": "string"
        },
        "enabled": {
          "default": true,
          "description": "Whether the job is scheduled. Defaults to `true`.",
          "type": "boolean"
        },
        "extension_id": {
          "description": "Installed extension that provides the connector operation.",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "description": "Operation input table passed to the extension.",
          "type": "object"
        },
        "input_file_id": {
          "description": "Uploaded file supplied to an import.",
          "type": [
            "string",
            "null"
          ]
        },
        "interval_seconds": {
          "description": "Run interval in seconds, from 60 to 2592000 (30 days).",
          "format": "int32",
          "maximum": 2592000,
          "minimum": 60,
          "type": [
            "integer",
            "null"
          ]
        },
        "operation_id": {
          "description": "Connector operation declared by the extension.",
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConnectorJobTrigger"
            },
            {
              "type": "null"
            }
          ],
          "description": "Also run an export when records of this blueprint change, once they\nhave been quiet for `debounce_seconds`."
        }
      },
      "required": [
        "code",
        "direction",
        "extension_id",
        "operation_id",
        "input"
      ],
      "type": "object"
    },
    "ConnectorJobTrigger": {
      "additionalProperties": false,
      "description": "A change trigger of an export connector job.",
      "properties": {
        "debounce_seconds": {
          "description": "Quiet period before a triggered run, from 1 to 3600 seconds.",
          "format": "int32",
          "maximum": 3600,
          "minimum": 1,
          "type": "integer"
        },
        "events": {
          "description": "Record event types that start a run, such as `record.updated.v1`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "events",
        "debounce_seconds"
      ],
      "type": "object"
    },
    "ExtensionOutletLayout": {
      "additionalProperties": false,
      "description": "Host-owned per-blueprint extension layout. It is declarative data only;\ncontribution keys cannot select DOM nodes or invoke extension code.",
      "properties": {
        "hidden": {
          "default": [],
          "description": "Contribution keys hidden in this outlet.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "order": {
          "default": [],
          "description": "Contribution keys (`<extension-id>:<contribution-id>`) in display order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "IncludeRef": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "description": "Local name used by `from = \"<alias>.<attribute>\"` selections.",
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "code": {
          "description": "Code of the included mixin blueprint.",
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string",
          "x-attricat-reference": "mixin"
        },
        "version": {
          "description": "Exact mixin version to include.",
          "format": "int64",
          "minimum": 1,
          "type": "integer",
          "x-attricat-reference": "mixin_version"
        }
      },
      "required": [
        "alias",
        "code",
        "version"
      ],
      "type": "object"
    },
    "IncomingRelationship": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "description": "Relationship attribute on the source blueprint.",
          "type": "string"
        },
        "source_blueprint": {
          "description": "Blueprint whose records reference this record.",
          "type": "string",
          "x-attricat-reference": "blueprint"
        }
      },
      "required": [
        "source_blueprint",
        "field"
      ],
      "type": "object"
    },
    "PublicationPolicy": {
      "additionalProperties": false,
      "properties": {
        "retain_on_edit_roles": {
          "default": [],
          "description": "Workspace roles whose edits keep records published on their channels.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-attricat-reference": "role"
        }
      },
      "type": "object"
    },
    "RawAttributeDeclaration": {
      "additionalProperties": false,
      "description": "An attribute declared by the blueprint or selected from an include.",
      "properties": {
        "acyclic": {
          "description": "Reject relationship writes that would form a cycle through this\nself-referencing attribute. Requires `context_editable = \"default\"`.",
          "type": [
            "boolean",
            "null"
          ],
          "x-attricat-value-types": [
            "relationship"
          ]
        },
        "allowed_extensions": {
          "default": [],
          "description": "Accepted file extensions without the leading dot.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-attricat-value-types": [
            "file"
          ]
        },
        "allowed_mime_groups": {
          "default": [],
          "description": "Accepted MIME groups, such as `image`.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-attricat-value-types": [
            "file"
          ]
        },
        "cardinality": {
          "description": "Relationships: `one`, `many` (default), or `one_to_one`.\nFiles: `one` (default) or `many`.",
          "enum": [
            "one",
            "many",
            "one_to_one"
          ],
          "type": [
            "string",
            "null"
          ],
          "x-attricat-value-types": [
            "relationship",
            "file"
          ]
        },
        "code": {
          "description": "Attribute identifier, unique within the blueprint.",
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "context_editable": {
          "default": "all",
          "description": "Contexts that accept writes: `all`, or only the `default` context.",
          "enum": [
            "all",
            "default"
          ],
          "type": "string"
        },
        "context_fallback": {
          "default": "default",
          "description": "Missing values in a non-default context: `default` inherits from the\nnearest ancestor context; `none` leaves the attribute absent.",
          "enum": [
            "default",
            "none"
          ],
          "type": "string"
        },
        "default_value": {
          "description": "Value stored in the default context when a record is created.\nNot supported for relationships and files."
        },
        "description": {
          "description": "What the attribute holds, for people and agents. Attributes selected\nwith `from` use the mixin's description and cannot set their own.\n`{{…}}` references resolve from the workspace lexicon.",
          "maxLength": 500,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "extension_configuration": {
          "description": "JSON configuration passed to the extension type.",
          "type": [
            "string",
            "null"
          ]
        },
        "extension_type": {
          "description": "A `provider:type@semver-range` reference resolved by the host using an\nenabled workspace installation.",
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "description": "Selects `<include alias>.<attribute code>` from an include. The\nattribute code must match `code`.",
          "type": [
            "string",
            "null"
          ],
          "x-attricat-reference": "include_attribute"
        },
        "generated": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawGeneratedValue"
            },
            {
              "type": "null"
            }
          ],
          "description": "Core assigns the value when a record is created, from a gapless\ncounter per blueprint family and attribute. Clients cannot write it.\nRecord blueprints only.",
          "x-attricat-value-types": [
            "string",
            "integer"
          ]
        },
        "image_only": {
          "description": "Accept only images and generate thumbnails.",
          "type": [
            "boolean",
            "null"
          ],
          "x-attricat-value-types": [
            "file"
          ]
        },
        "max_bytes": {
          "description": "Maximum upload size in bytes.",
          "format": "uint64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ],
          "x-attricat-value-types": [
            "file"
          ]
        },
        "name": {
          "description": "Human-readable label shown in forms, filters, and table headers.\nDefaults to the humanized `code`. Attributes selected with `from` use\nthe mixin's name and cannot set their own. `{{…}}` references resolve\nfrom the workspace lexicon.",
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "ordered": {
          "description": "Whether multiple files keep their order. Defaults to `true` for `many`.",
          "type": [
            "boolean",
            "null"
          ],
          "x-attricat-value-types": [
            "file"
          ]
        },
        "purposes": {
          "default": [],
          "description": "File purpose codes, such as `product_image`.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-attricat-value-types": [
            "file"
          ]
        },
        "readonly": {
          "default": false,
          "description": "Preview-only in the Attricat web app. API writes remain allowed.",
          "type": "boolean"
        },
        "tags": {
          "default": [],
          "description": "Free-form metadata. `hidden`, `hidden:form`, `hidden:detail`,\n`hidden:explorer`, and `hidden:metadata` hide the attribute from default UI.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-attricat-suggestions": [
            "hidden",
            "hidden:form",
            "hidden:detail",
            "hidden:explorer",
            "hidden:metadata"
          ]
        },
        "target_blueprint": {
          "description": "Blueprint that relationship targets must use.",
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": [
            "string",
            "null"
          ],
          "x-attricat-reference": "blueprint",
          "x-attricat-value-types": [
            "relationship"
          ]
        },
        "target_blueprints": {
          "default": [],
          "description": "Several blueprints that relationship targets may use. Cannot be\ncombined with `target_blueprint`.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "x-attricat-reference": "blueprint",
          "x-attricat-value-types": [
            "relationship"
          ]
        },
        "target_cardinality": {
          "description": "How many sources may link to one target. Defaults to `many`.",
          "enum": [
            "one",
            "many"
          ],
          "type": [
            "string",
            "null"
          ],
          "x-attricat-value-types": [
            "relationship"
          ]
        },
        "tree": {
          "description": "An acyclic hierarchy in which every record has at most one target\n(parent). Implies `acyclic` and `cardinality = \"one\"`.",
          "type": [
            "boolean",
            "null"
          ],
          "x-attricat-value-types": [
            "relationship"
          ]
        },
        "value_schema": {
          "description": "JSON Schema (Draft 2020-12) source for scalar values.",
          "type": [
            "string",
            "null"
          ]
        },
        "value_type": {
          "description": "Stored value type.",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "date",
            "datetime",
            "time",
            "json",
            "relationship",
            "file"
          ],
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "RawGeneratedValue": {
      "additionalProperties": false,
      "description": "`generated = { … }` on an attribute.",
      "properties": {
        "format": {
          "description": "Required on string attributes: literal text with exactly one `{n}` or\n`{n:0W}` counter token (W from 1 to 18 zero-pads), plus optional\n`{yyyy}`, `{yy}`, `{mm}` and `{dd}` date tokens. `{{` and `}}` are\nliteral braces. Integer attributes take no format.",
          "maxLength": 100,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "reset": {
          "description": "When numbering restarts at `start`. Defaults to `never`; other values\nneed date tokens that identify the period.",
          "enum": [
            "never",
            "yearly",
            "monthly",
            "daily"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "description": "The first number of a new counter. Defaults to 1.",
          "format": "int64",
          "maximum": 999999999999999999,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "time_zone": {
          "description": "IANA time zone for date tokens and periods. Defaults to `UTC`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TableColumn": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "description": "A local scalar field or up to three relationship hops ending in a scalar field.",
          "type": "string",
          "x-attricat-reference": "attribute_path"
        },
        "label": {
          "default": null,
          "description": "Column heading. Defaults to the attribute name. `{{…}}` references\nresolve from the workspace lexicon.",
          "type": [
            "string",
            "null"
          ]
        },
        "renderer": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cell renderer, such as `attricat.table_image`."
        }
      },
      "required": [
        "field"
      ],
      "type": "object"
    },
    "UniqueKeyDefinition": {
      "additionalProperties": false,
      "description": "A business key: no two records of the blueprint family may share the\nnormalized values of these attributes.",
      "properties": {
        "attributes": {
          "description": "One to eight scalar attributes, or single-target relationships, whose\ncombined values must be unique.",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array",
          "x-attricat-reference": "attribute"
        },
        "case_sensitive": {
          "default": false,
          "description": "Compare strings exactly. By default strings are compared after\ntrimming, collapsing whitespace, and lowercasing.",
          "type": "boolean"
        },
        "code": {
          "description": "Stable key identifier, unique within the blueprint.",
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "scope": {
          "default": "workspace",
          "description": "`workspace` (default) compares default-context values; `context`\ncompares resolved values separately in every context.",
          "enum": [
            "workspace",
            "context"
          ],
          "type": "string"
        }
      },
      "required": [
        "code",
        "attributes"
      ],
      "type": "object"
    },
    "ViewDefinition": {
      "description": "A named view. `dropdown_option` labels relationship choices, `page_title`\nnames the record page, `table` configures Explorer columns, `explorer`\nsets Explorer defaults, and layout roots arrange `detail` and `edit`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Label shown for the record in relationship dropdowns.",
          "properties": {
            "fields": {
              "description": "Attributes joined into the label.",
              "items": {
                "type": "string"
              },
              "type": "array",
              "x-attricat-reference": "attribute"
            },
            "separator": {
              "default": " · ",
              "description": "Text between label fields. Defaults to ` · `.",
              "type": "string"
            },
            "type": {
              "const": "dropdown_option",
              "type": "string"
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Title of the record page and its browser tab.",
          "properties": {
            "fields": {
              "description": "Attributes joined into the title.",
              "items": {
                "type": "string"
              },
              "type": "array",
              "x-attricat-reference": "attribute"
            },
            "separator": {
              "default": " · ",
              "description": "Text between title fields. Defaults to ` · `.",
              "type": "string"
            },
            "type": {
              "const": "page_title",
              "type": "string"
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explorer table columns.",
          "properties": {
            "columns": {
              "default": null,
              "description": "Table columns.",
              "items": {
                "$ref": "#/$defs/TableColumn"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "component": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ComponentReference"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Registered component that renders this block."
            },
            "type": {
              "const": "table",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explorer defaults for this blueprint's results.",
          "properties": {
            "browse_by": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BrowseBy"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Relationship field the browse rail lists until a person picks\nanother, or `false` to keep the rail closed. The field must have\na single target blueprint. A dotted path such as `model.brand`\nfollows up to three such relationships, each with\n`cardinality = \"one\"`, and lists the last one's targets."
            },
            "type": {
              "const": "explorer",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Blocks stacked vertically.",
          "properties": {
            "children": {
              "description": "Nested blocks.",
              "items": {
                "$ref": "#/$defs/ViewNode"
              },
              "type": "array"
            },
            "component": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ComponentReference"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Registered component that renders this block."
            },
            "type": {
              "const": "stack",
              "type": "string"
            }
          },
          "required": [
            "type",
            "children"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Blocks arranged in a responsive grid.",
          "properties": {
            "children": {
              "description": "Nested blocks.",
              "items": {
                "$ref": "#/$defs/ViewNode"
              },
              "type": "array"
            },
            "component": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ComponentReference"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Registered component that renders this block."
            },
            "type": {
              "const": "grid",
              "type": "string"
            }
          },
          "required": [
            "type",
            "children"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Blocks grouped in a section.",
          "properties": {
            "children": {
              "description": "Nested blocks.",
              "items": {
                "$ref": "#/$defs/ViewNode"
              },
              "type": "array"
            },
            "component": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ComponentReference"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Registered component that renders this block."
            },
            "type": {
              "const": "section",
              "type": "string"
            }
          },
          "required": [
            "type",
            "children"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Blocks split into tabs.",
          "properties": {
            "component": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ComponentReference"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Registered component that renders this block."
            },
            "tabs": {
              "description": "Tabs, each with a label and its own blocks.",
              "items": {
                "$ref": "#/$defs/ViewTab"
              },
              "type": "array"
            },
            "type": {
              "const": "tabs",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tabs"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Blocks split into collapsible sections.",
          "properties": {
            "component": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ComponentReference"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Registered component that renders this block."
            },
            "sections": {
              "description": "Collapsible sections, each with a label and its own blocks.",
              "items": {
                "$ref": "#/$defs/ViewSection"
              },
              "type": "array"
            },
            "type": {
              "const": "accordion",
