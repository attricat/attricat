  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An Attricat blueprint: a versioned entity type or an includable mixin.",
  "properties": {
    "attributes": {
      "description": "Attributes in display order. Each declares exactly one of `value_type`,\n`extension_type`, or `from`.",
      "items": {
        "$ref": "#/$defs/RawAttributeDeclaration"
      },
      "minItems": 1,
      "type": "array"
    },
    "code": {
      "description": "Stable blueprint identifier, using ASCII letters, numbers, hyphens, and underscores.",
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "connector_jobs": {
      "default": [],
      "description": "Scheduled extension imports and exports. Entity blueprints only.",
      "items": {
        "$ref": "#/$defs/ConnectorJobDefinition"
      },
      "type": "array"
    },
    "entity_schema": {
      "description": "JSON Schema (Draft 2020-12) source for cross-field entity validation.\nEntity blueprints only.",
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "additionalProperties": true,
      "default": {},
      "description": "Namespaced extension metadata is preserved in the immutable source\ndefinition and intentionally ignored by the core blueprint compiler.",
      "type": "object"
    },
    "format_version": {
      "const": 1,
      "description": "Definition format version. Only `1` is supported.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "includes": {
      "default": [],
      "description": "Exact, version-pinned mixins whose attributes can be selected with `from`.",
      "items": {
        "$ref": "#/$defs/IncludeRef"
      },
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/BlueprintKind"
    },
    "name": {
      "description": "Human-readable blueprint name.",
      "minLength": 1,
      "type": "string"
    },
    "publication": {
      "$ref": "#/$defs/PublicationPolicy",
      "default": {
        "retain_on_edit_roles": []
      },
      "description": "Channel publication behavior when entities are edited."
    },
    "rules": {
      "default": [],
      "description": "Data-health rules evaluated for this blueprint's entities.",
      "items": {
        "additionalProperties": false,
        "description": "A data-health rule that reports findings for entities matching its predicate.",
        "properties": {
          "code": {
            "description": "Stable rule identifier, unique within its owner.",
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "name": {
            "description": "Human-readable rule name.",
            "type": "string"
          },
          "predicate": {
            "$ref": "#/$defs/RawPredicate"
          },
          "severity": {
            "$ref": "#/$defs/Severity"
          },
          "triggers": {
            "description": "One to eight events that evaluate the rule.",
            "items": {
              "$ref": "#/$defs/RawTrigger"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "code",
          "name",
          "severity",
          "triggers",
          "predicate"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "views": {
      "additionalProperties": {
        "$ref": "#/$defs/ViewDefinition"
      },
      "default": {},
      "description": "Named views: `dropdown_option`, `table`, `detail`, `edit`, and `extension_layout`.",
      "type": "object",
      "x-attricat-key-suggestions": [
        "dropdown_option",
        "detail",
        "edit",
        "table",
        "extension_layout"
      ]
    }
  },
  "required": [
    "format_version",
    "code",
    "name",
    "kind",
    "attributes"
  ],
  "title": "Attricat blueprint definition v1",
  "type": "object"
