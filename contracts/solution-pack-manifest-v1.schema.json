{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attricat.com/contracts/solution-pack-manifest-v1.schema.json",
  "title": "Attricat solution-pack manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "name",
    "version",
    "description",
    "catalog",
    "resources"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_api"
      ],
      "properties": {
        "host_api": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extensions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/extensionRequirement"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blueprints": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/blueprintResource"
          }
        },
        "presentation_assets": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/presentationAssetResource"
          }
        },
        "workspace_settings": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/exploreNavigationResource"
              },
              {
                "$ref": "#/$defs/extensionLayoutResource"
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "$ref": "#/$defs/exploreNavigationResource"
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "$ref": "#/$defs/extensionLayoutResource"
              },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        },
        "sample_data": {
          "$ref": "#/$defs/sampleDataResource"
        }
      },
      "anyOf": [
        {
          "required": [
            "blueprints"
          ],
          "properties": {
            "blueprints": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "workspace_settings"
          ],
          "properties": {
            "workspace_settings": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "presentation_assets"
          ],
          "properties": {
            "presentation_assets": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "sample_data"
          ]
        }
      ]
    },
    "documentation": {
      "$ref": "#/$defs/documentation"
    },
    "checks": {
      "$ref": "#/$defs/fileRefJson"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blueprintResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "path",
        "required",
        "sha256"
      ],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^blueprints/[a-z][a-z0-9_-]*$"
        },
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^blueprints/.+\\.toml$"
        },
        "required": {
          "type": "boolean"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "presentationAssetResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "path",
        "required",
        "purpose",
        "media_type",
        "sha256"
      ],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^assets/[a-z][a-z0-9_-]*$"
        },
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^assets/[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
        },
        "required": {
          "type": "boolean"
        },
        "purpose": {
          "enum": [
            "logo",
            "icon",
            "illustration"
          ]
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/svg+xml"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "media_type": {
                "const": "image/jpeg"
              }
            }
          },
          "then": {
            "properties": {
              "purpose": {
                "const": "illustration"
              }
            }
          }
        }
      ]
    },
    "exploreNavigationResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "path",
        "required",
        "sha256"
      ],
      "properties": {
        "key": {
          "const": "workspace/explore-navigation"
        },
        "path": {
          "const": "workspace/explore-navigation.json"
        },
        "required": {
          "type": "boolean"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "extensionLayoutResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "path",
        "required",
        "sha256"
      ],
      "properties": {
        "key": {
          "const": "workspace/extension-layout"
        },
        "path": {
          "const": "workspace/extension-layout.json"
        },
        "required": {
          "type": "boolean"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "extensionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "id",
        "version",
        "required"
      ],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^extensions/[a-z][a-z0-9_-]*$",
          "not": {
            "pattern": "^extensions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?:[0-9*<>=~^])[0-9A-Za-z*<>=~^.,+ -]*$"
        },
        "required": {
          "type": "boolean"
        },
        "configuration_template": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/configurationTemplate"
            }
          ]
        }
      }
    },
    "configurationTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^extensions/[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*\\.json$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "fileRefMarkdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\u0000-\\u001F\\u007F-\\u009F])[^/]+(?:/[^/]+)*\\.md$",
          "$comment": "Runtime also enforces this 512-byte limit in UTF-8; JSON Schema maxLength counts Unicode code points."
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "fileRefJson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\u0000-\\u001F\\u007F-\\u009F])[^/]+(?:/[^/]+)*\\.json$",
          "$comment": "Runtime also enforces this 512-byte limit in UTF-8; JSON Schema maxLength counts Unicode code points."
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readme": {
          "$ref": "#/$defs/fileRefMarkdown"
        },
        "release_notes": {
          "$ref": "#/$defs/fileRefMarkdown"
        },
        "setup_checklist": {
          "$ref": "#/$defs/fileRefJson"
        }
      },
      "minProperties": 1
    },
    "sampleDataResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "path",
        "sha256"
      ],
      "properties": {
        "key": {
          "const": "sample-data/default"
        },
        "path": {
          "const": "sample-data/sample-data.json"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
