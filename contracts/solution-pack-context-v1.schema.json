{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attricat.com/contracts/solution-pack-context-v1.schema.json",
  "title": "Attricat solution-pack context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "solution_pack_context"
    },
    "data": {
      "type": "object",
      "$comment": "Runtime also limits the serialized object to 4 KiB."
    },
    "parent": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^contexts/[a-z][a-z0-9_-]*$"
    },
    "publication_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "required_rules": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "$comment": "Logical keys of rules the pack declares; installed with their physical rule codes.",
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^rules/[a-z][a-z0-9_-]*$"
          }
        },
        "require_valid_entity": {
          "type": "boolean"
        }
      }
    }
  }
}
