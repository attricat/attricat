{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attricat.com/contracts/solution-pack-lexicon-v1.schema.json",
  "title": "Attricat solution-pack lexicon v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "languages"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "lexicon"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "entries"
        ],
        "properties": {
          "language": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "text"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "English source text referenced as `{{key}}`."
                },
                "context": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "Disambiguation context referenced as `{{key|context}}`."
                },
                "plural_category": {
                  "enum": [
                    "zero",
                    "one",
                    "two",
                    "few",
                    "many",
                    "other"
                  ],
                  "description": "CLDR plural category. Defaults to `other`."
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            }
          }
        }
      }
    }
  }
}
