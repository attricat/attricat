{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attricat status control v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "options"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tone": {
            "enum": [
              "default",
              "success",
              "warning",
              "error",
              "info"
            ]
          },
          "lock": {
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 500,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 257,
                  "pattern": "^[A-Za-z0-9_-]+(:[A-Za-z0-9_-]+)?$"
                }
              }
            ]
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "covers",
              "void_to"
            ],
            "properties": {
              "covers": {
                "oneOf": [
                  {
                    "const": "all"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 257,
                      "pattern": "^[A-Za-z0-9_-]+(:[A-Za-z0-9_-]+)?$"
                    }
                  }
                ]
              },
              "void_to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            }
          },
          "retention_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 36600
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": [
              "string",
              "null"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "permission": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "separate_from": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "conditions": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "predicate"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "predicate": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
