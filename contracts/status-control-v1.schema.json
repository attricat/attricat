{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attricat status control v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "options"
  ],
  "properties": {
    "version": {
      "const": 1,
      "description": "Version of the status annotation; always 1."
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "description": "One option per `enum` code, in display order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "The `enum` value this option describes."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Name shown for the status. May use `{{key}}` lexicon references."
          },
          "tone": {
            "enum": [
              "default",
              "success",
              "warning",
              "error",
              "info"
            ],
            "description": "Colour the status is shown in."
          },
          "lock": {
            "description": "Makes the covered attributes read-only in this status and blocks deleting the record: `\"all\"` or attribute codes (`namespace:code` for reusable attributes). Requires `transitions`.",
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 500,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 257,
                  "pattern": "^[A-Za-z0-9_-]+(:[A-Za-z0-9_-]+)?$"
                }
              }
            ]
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "covers",
              "void_to"
            ],
            "description": "Records an approval bound to the covered content; changing that content moves the record to `void_to`.",
            "properties": {
              "covers": {
                "description": "The attributes the approval covers: `\"all\"` or attribute codes.",
                "oneOf": [
                  {
                    "const": "all"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 257,
                      "pattern": "^[A-Za-z0-9_-]+(:[A-Za-z0-9_-]+)?$"
                    }
                  }
                ]
              },
              "void_to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$",
                "description": "The option a change to covered content moves the record to."
              }
            }
          },
          "retention_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 36600,
            "description": "Days the locked attributes' files are held. Requires `lock`."
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "description": "The allowed changes. Omit to allow any change; an empty list allows none. Keeping the same value is always allowed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": [
              "string",
              "null"
            ],
            "description": "Option code before the change, or `null` when the value is first set."
          },
          "to": {
            "type": [
              "string",
              "null"
            ],
            "description": "Option code after the change, or `null` when the value is cleared."
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Names the transition, for `separate_from` and the audit trail."
          },
          "permission": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z_]+\\.[a-z_]+$",
            "description": "Permission (`area.action`) the user needs to make this change."
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "description": "Roles, held through a workspace, blueprint-family or record grant, that may make this change."
          },
          "separate_from": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "description": "Transition codes whose most recent actor on this record and context may not make this change."
          },
          "conditions": {
            "type": "array",
            "maxItems": 16,
            "description": "Checks that must hold for the record before the change is allowed, with the predicate shape of record checks. Synchronous-safe predicates only.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "predicate"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "description": "Names the condition in errors."
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Shown when the condition is not met, instead of the default message."
                },
                "predicate": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    }
                  },
                  "description": "What must hold for the record."
                }
              }
            }
          }
        }
      }
    }
  }
}
