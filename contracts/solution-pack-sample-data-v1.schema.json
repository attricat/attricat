{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attricat.com/contracts/solution-pack-sample-data-v1.schema.json",
  "title": "Attricat solution-pack sample data v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "kind", "classification", "records"],
  "properties": {
    "format_version": {"const": 1},
    "kind": {"const": "solution_pack_sample_data"},
    "classification": {"const": "synthetic"},
    "records": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "blueprint", "facts", "relationships"],
        "properties": {
          "key": {"type": "string", "pattern": "^sample-records/[a-z][a-z0-9_-]*$", "maxLength": 144},
          "blueprint": {"type": "string", "pattern": "^blueprints/[a-z][a-z0-9_-]*$", "maxLength": 128},
          "facts": {
            "type": "array", "maxItems": 128,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["attribute", "value"],
              "properties": {
                "attribute": {"type": "string", "pattern": "^blueprints/[a-z][a-z0-9_-]*/attributes/[a-z][a-z0-9_-]*$", "maxLength": 272},
                "context": {"$ref": "#/$defs/context"},
                "value": {
                  "oneOf": [
                    {"type": ["string", "number", "integer", "boolean"]},
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["time", "time_zone"],
                      "properties": {
                        "time": {"type": "string"},
                        "time_zone": {"type": "string"}
                      }
                    }
                  ]
                }
              }
            }
          },
          "relationships": {
            "type": "array", "maxItems": 128,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["attribute", "targets"],
              "properties": {
                "attribute": {"type": "string", "pattern": "^blueprints/[a-z][a-z0-9_-]*/attributes/[a-z][a-z0-9_-]*$", "maxLength": 272},
                "context": {"$ref": "#/$defs/context"},
                "targets": {
                  "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^sample-records/[a-z][a-z0-9_-]*$", "maxLength": 144}
                }
              }
            }
          },
          "files": {
            "type": "array", "maxItems": 128,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["attribute", "files"],
              "properties": {
                "attribute": {"type": "string", "pattern": "^blueprints/[a-z][a-z0-9_-]*/attributes/[a-z][a-z0-9_-]*$", "maxLength": 272},
                "context": {"$ref": "#/$defs/context"},
                "files": {
                  "type": "array", "minItems": 1, "maxItems": 16,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["path", "filename", "media_type"],
                    "properties": {
                      "path": {"type": "string", "pattern": "^sample-data/files/[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$", "maxLength": 512},
                      "filename": {"type": "string", "minLength": 3, "maxLength": 255},
                      "media_type": {"enum": ["image/png", "image/jpeg", "image/webp", "application/pdf", "text/plain"]}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "context": {"type": "string", "pattern": "^contexts/[a-z][a-z0-9_-]*$", "maxLength": 128}
  }
}
