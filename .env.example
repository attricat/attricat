# `just setup` replaces these local-development values with worktree-specific ports.
# PostgreSQL connection string used by SQLx migrations and API startup.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/catalog
BIND_ADDR=127.0.0.1:3000
# Server-selected workspace. It is intentionally not accepted from HTTP bodies.
CATALOG_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
CATALOG_BOOTSTRAP_WORKSPACE_NAME=Default workspace
CATALOG_BOOTSTRAP_OWNER_EMAIL=owner@example.test
# Structured tracing verbosity (for example, api=debug).
RUST_LOG=info
CATALOG_API_URL=http://127.0.0.1:3000
POSTGRES_PORT=5432
WEB_PORT=5173
