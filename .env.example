# `just setup` replaces these local-development values with worktree-specific ports.
# PostgreSQL connection string used by SQLx migrations and API startup.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/catalog
BIND_ADDR=127.0.0.1:3000
# Server-selected workspace. It is intentionally not accepted from HTTP bodies.
CATALOG_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
CATALOG_BOOTSTRAP_WORKSPACE_NAME="Default workspace"
CATALOG_BOOTSTRAP_OWNER_EMAIL=owner@example.test
# Development-only bootstrap password. Use a secret manager in deployment.
CATALOG_BOOTSTRAP_OWNER_PASSWORD=test
# Local development serves HTTP. Set true in deployed HTTPS environments.
SESSION_COOKIE_SECURE=false
# Structured tracing verbosity (for example, api=debug).
RUST_LOG=info
# Local Jaeger trace collector. Unset this outside local development to disable OTLP export.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4317
# Enable development-only diagnostics in the API and web application.
CATALOG_DEVTOOLS=true
# Optional OpenAI-compatible agent provider. Leave LLM_API_KEY unset to disable
# agents; this secret is API-process-only and must never be exposed to the web app.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# On macOS, if the API binary cannot route to a LAN LiteLLM host but curl can,
# see docs/configuration.md#macos-litellm-loopback-proxy.
# LLM_UPSTREAM_BASE_URL=http://192.168.1.100:4000/v1
# LLM_LOOPBACK_PROXY_PORT=4010
LLM_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_RUN_TIMEOUT_SECONDS=300
CATALOG_API_URL=http://127.0.0.1:3000
# Canonical public GitHub owner/repository used as the built-in extension source.
EXTENSION_OFFICIAL_REGISTRY=attricat/attricat-extensions
# Local-only Mailpit SMTP adapter. `just setup` assigns the Mailpit ports per worktree.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Catalog <no-reply@catalog.local>"
PASSWORD_RESET_URL=http://127.0.0.1:5173/password-reset/confirm
POSTGRES_PORT=5432
WEB_PORT=5173
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_UI_PORT=16686
# S3-compatible object storage. RustFS is started locally by `just dev`; deployed
# environments must set all values explicitly for their S3-compatible provider.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=catalog-files
S3_ACCESS_KEY_ID=catalog-dev
S3_SECRET_ACCESS_KEY=catalog-dev-secret
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_TIMEOUT_SECONDS=30
S3_DOWNLOAD_TIMEOUT_SECONDS=30
# HTTP upload guardrails; blueprint policies can impose lower per-attribute limits.
FILE_UPLOAD_MAX_BYTES=52428800
FILE_UPLOAD_MAX_FILES=10
# Delay between durable-job polls in milliseconds.
FILE_WORKER_POLL_MILLISECONDS=500
# Image-processing limits. Values must be positive integers.
FILE_WORKER_MAX_PIXELS=40000000
FILE_WORKER_MAX_ATTEMPTS=5
# Retain unreferenced file objects for one day before the worker purges them.
FILE_DELETE_GRACE_SECONDS=86400
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
